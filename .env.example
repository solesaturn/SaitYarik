DATABASE_URL="file:./dev.db"

# Подпись сессий (≥16 символов). На Vercel без него используется производный ключ от VERCEL_PROJECT_ID.
SESSION_SECRET="replace-with-long-random-string"
NEXTAUTH_SECRET="replace-with-long-random-string"

# ЮKassa: demo = локальная демо-оплата. Реальные ключи — для боя.
YOOKASSA_SHOP_ID="demo"
YOOKASSA_SECRET_KEY="demo"
# ALLOW_DEMO_PAYMENTS="0"

# CommerceML / 1С (HTTP Basic). В проде обязательно задать.
CML_LOGIN="1c"
CML_PASSWORD="replace-me"
# ALLOW_DEMO_1C="1"

# ALLOW_DEMO_LOGIN="0" — отключить сидовые admin/demo/opt

NEXT_PUBLIC_SITE_URL="https://sait-yarik.vercel.app"
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
DELIVERY_PROVIDER="cdek"
